{
	"name": "ac-modern",
	"private": true,
	"version": "0.3.0",
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
		"seed": "node --no-warnings --experimental-strip-types scripts/seed.ts",
		"screenshots": "node scripts/screenshots.mjs",
		"docs:openapi": "node --no-warnings --experimental-strip-types scripts/openapi.ts",
		"docs:dev": "pnpm docs:openapi && cd docs && npx --yes mint@latest dev",
		"cli": "node --no-warnings --experimental-strip-types scripts/cli.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "1.5.6",
		"playwright": "1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"nodemailer": "^10.4.0",
		"openid-client": "^6.8.9",
		"pg": "^8.23.1",
		"qrcode": "1.5.4"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Armistice-Group/ac-modern"
	}
}
