# Copy to .env for local development. Everything is optional.

# self-hosted (one organisation, setup wizard) or cloud (anyone can sign up and create organisations)
# ACM_MODE=self-hosted
# Where the SQLite database and secret key live.
# ACM_DATA_DIR=./data
# Use Postgres instead of SQLite (recommended for cloud mode).
# ACM_DATABASE_URL=postgres://acm:secret@localhost:5432/acm
# Encrypts stored secrets (Slack URL, webhook signing keys). Otherwise a key file is generated in the data folder.
# ACM_SECRET_KEY=
# Base URL for links in notifications.
# ACM_PUBLIC_URL=https://access.example.com
# Email.
# ACM_SMTP_URL=smtps://user:pass@smtp.example.com
# ACM_SMTP_FROM=ac·modern <access@example.com>
# First owner without the setup wizard.
# ACM_ADMIN_EMAIL=you@example.com
# ACM_ADMIN_PASSWORD=
# ACM_ORG_NAME=Acme
# Cloud mode: who may sign up (comma-separated; *@example.com, someone@x.com). Empty = anyone.
# ACM_SIGNUP_ALLOW=
# How often grants are checked for expiry (seconds).
# ACM_JOB_INTERVAL_SECONDS=60
# Self-hosted single sign-on (otherwise set it up under Settings → Single sign-on).
# Redirect URI to register: <your url>/auth/oidc/callback
# ACM_OIDC_ISSUER=https://acme.okta.com
# ACM_OIDC_CLIENT_ID=
# ACM_OIDC_CLIENT_SECRET=
# ACM_OIDC_NAME=Okta
# ACM_OIDC_DOMAINS=acme.com
# ACM_OIDC_REQUIRED=false
# How often Google/Okta/Microsoft directories are pulled (minutes).
# ACM_DIRECTORY_SYNC_MINUTES=30
# Cloud: one shared Slack app for "Add to Slack" (redirect URL <url>/api/slack/oauth, interactivity <url>/api/slack/interactions).
# ACM_SLACK_CLIENT_ID=
# ACM_SLACK_CLIENT_SECRET=
# ACM_SLACK_SIGNING_SECRET=
